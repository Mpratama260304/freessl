NODE_ENV=production
SITE_URL=https://ssl.example.com
ACME_ENVIRONMENT=staging
ACME_ACCOUNT_EMAIL=admin@example.com
ACME_TERMS_AGREED=false
ACME_DATA_DIR=/app/data/acme
REDIS_URL=redis://redis:6379
ORDER_TTL_SECONDS=1800
MAX_DOMAINS_PER_CERT=10
MAX_ORDER_PER_IP_PER_HOUR=5
MAX_ORDERS_GLOBAL_PER_HOUR=100
TRUST_PROXY=true
RATE_LIMIT_SECRET=replace-with-a-random-secret-at-least-32-characters
TLS_ACME_ENVIRONMENT=staging
HTTP_PORT=80
HTTPS_PORT=443